# Server
PORT=3000
NODE_ENV=development

# Database — postgres (docker compose up -d postgres → host port 15432) or sqlite
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=whatsapp_automation
# Zero-config local fallback:
# DB_TYPE=sqlite
# DB_DATABASE=data/whatsapp-automation.sqlite

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Sankar

# WhatsApp provider: mock | none (real providers plug in behind the adapter)
WHATSAPP_PROVIDER=mock
# Simulated transient failure rate for the mock provider (0..1)
MOCK_FAILURE_RATE=0.1

# Scheduler
SCHEDULER_ENABLED=true
MAX_SEND_ATTEMPTS=3
RETRY_BASE_DELAY_MS=2000
SEND_TIMEOUT_MS=15000

# Optional: OpenAI key for AI-assisted message composing (Messages page)
OPENAI_API_KEY=
